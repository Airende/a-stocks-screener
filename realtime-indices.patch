+def _is_trading_time() -> bool:
+    """判断当前是否为 A 股交易时段 (工作日 9:30-11:30 / 13:00-15:00)"""
+    now_bj = datetime.now(_BJ_TZ)
+    if now_bj.weekday() >= 5:  # 周末
+        return False
+    t = now_bj.hour * 60 + now_bj.minute
+    return (9 * 60 + 30 <= t <= 11 * 60 + 30) or (13 * 60 <= t <= 15 * 60)
